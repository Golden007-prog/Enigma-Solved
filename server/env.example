# Copy to server/.env and fill in. NEVER commit .env. Values are read by server.py via python-dotenv.

# Supabase cloud project "Enigma for Masai" (ap-northeast-1). URL + anon key are public; the service-role
# key is server-only: copy it from Supabase Dashboard -> Project Settings -> API Keys (secret / service_role).
SUPABASE_URL=https://reqleijouyejjzstyjeq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# cloud | selfhosted | off  -- off disables the sync worker entirely (airplane-mode rehearsals)
SUPABASE_MODE=off

# Pairing token: leave empty for a fresh random token per server start, or fix one for rehearsals.
SESSION_TOKEN_SECRET=

# LM Studio (never bind LM Studio beyond localhost)
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=interviewer

# Where the weights live (HF cache underneath). Run with HF_HUB_OFFLINE=1 once everything is downloaded.
MODELS_DIR=E:\Enigma for Masai\server\models
